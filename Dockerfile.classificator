# Multi-stage Dockerfile para o subsistema Classificator (Router e Engine)

# 1. Builder Stage
FROM golang:bookworm AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Compila o router com binário estático e flags de otimização
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/bin/classificator-router ./cmd/classificator-router

# Compila o engine com binário estático e flags de otimização
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/bin/classificator-engine ./cmd/classificator-engine

# 2. Router Runtime
FROM debian:bookworm-slim AS router
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/bin/classificator-router /app/classificator-router
EXPOSE 2800 2809
ENTRYPOINT ["/app/classificator-router"]

# 3. Engine Runtime
FROM debian:bookworm-slim AS engine
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/bin/classificator-engine /app/classificator-engine
EXPOSE 2801 2802 2803
ENTRYPOINT ["/app/classificator-engine"]
